{
  "name": "blocklauncher-minecraft",
  "productName": "BlockLauncher",
  "version": "1.1.0",
  "description": "Launcher de Minecraft offline con soporte para Fabric, Forge y NeoForge, gestor de mods y Java automático",
  "main": "main.js",
  "homepage": "https://github.com/menona46626246/BlockLauncher",
  "repository": {
    "type": "git",
    "url": "https://github.com/menona46626246/BlockLauncher.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "start:node": "node main.js",
    "dist": "electron-builder --win",
    "test": "node --test"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "blocklauncher",
    "offline",
    "mods",
    "fabric",
    "forge",
    "neoforge"
  ],
  "author": "menona46626246",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.10",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "optionalDependencies": {
    "adlauncher-core": "^2.0.0"
  },
  "build": {
    "appId": "com.menona466262.blocklauncher",
    "productName": "BlockLauncher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "!**/*.md"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "BlockLauncher"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
